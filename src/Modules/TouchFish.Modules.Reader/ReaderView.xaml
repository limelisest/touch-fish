<UserControl x:Class="TouchFish.Modules.Reader.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="820" MinHeight="580">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource PageTitleStyle}" Text="看书" />
                <TextBlock Style="{DynamicResource PageSubtitleStyle}"
                           Text="管理本地 TXT 书库，继续上次阅读位置，并自定义阅读体验。" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource PrimaryActionButtonStyle}"
                    Content="打开阅读窗口" Command="{Binding OpenReaderCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="书库" />
                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                       Text="存储于用户文档目录" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,3" CornerRadius="10"
                                Background="{DynamicResource SurfaceAlternateBrush}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Books.Count, StringFormat={}{0} 本}" />
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{DynamicResource ModernListBoxStyle}"
                             ItemContainerStyle="{DynamicResource ModernListItemStyle}"
                             ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="TXT 本地书籍" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Margin="0,12,0,0" Style="{DynamicResource SubtleCardStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Style="{DynamicResource FieldLabelStyle}" Text="书籍管理" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="打开目录"
                                        Command="{Binding OpenLibraryFolderCommand}" />
                                <Button Grid.Column="2" Style="{DynamicResource DangerButtonStyle}"
                                        Content="删除书籍" Command="{Binding DeleteBookCommand}" />
                            </Grid>
                            <Button Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Content="导入 TXT" Command="{Binding ImportBookCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="章节" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                   Text="选择章节后从记忆位置继续" />
                    </StackPanel>
                    <ListBox x:Name="ChapterList" Grid.Row="1" Style="{DynamicResource ModernListBoxStyle}"
                             ItemContainerStyle="{DynamicResource ModernListItemStyle}"
                             ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}"
                             SelectionChanged="ChapterList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Index}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="书籍信息" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="查看并修改当前选中书籍的信息。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="书名" />
                                <TextBox Grid.Column="1" Margin="8,4"
                                         Text="{Binding SelectedBook.Title, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="章节数量" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,8,0,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Chapters.Count, StringFormat={}{0} 章}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="阅读外观" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="调整字体、排版和阅读窗口显示效果。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="字体" />
                                <Grid Grid.Column="1" Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border MinHeight="40" Padding="10,6" CornerRadius="6"
                                            Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            ToolTip="{Binding SelectedBook.ReaderFontFamily}">
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SelectedBook.ReaderFontFamily}" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="选择…"
                                            Command="{Binding ChooseFontCommand}" />
                                </Grid>

                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="字号" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="10" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedBook.ReaderFontSize, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedBook.ReaderFontSize, StringFormat={}{0:0}}" />
                                </Grid>

                                <TextBlock Grid.Row="2" Style="{DynamicResource FieldLabelStyle}" Text="行间距" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedBook.ReaderLineSpacing, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedBook.ReaderLineSpacing, StringFormat={}{0:0.00}}" />
                                </Grid>

                                <TextBlock Grid.Row="3" Style="{DynamicResource FieldLabelStyle}" Text="段落间距" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedBook.ReaderParagraphSpacing, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedBook.ReaderParagraphSpacing, StringFormat={}{0:0}}" />
                                </Grid>

                                <TextBlock Grid.Row="4" Style="{DynamicResource FieldLabelStyle}" Text="透明度" />
                                <Grid Grid.Row="4" Grid.Column="1" Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding SelectedBook.ReaderWindowOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedBook.ReaderWindowOpacity, StringFormat={}{0:P0}}" />
                                </Grid>

                                <TextBlock Grid.Row="5" Style="{DynamicResource FieldLabelStyle}" Text="窗口" />
                                <CheckBox Grid.Row="5" Grid.Column="1" Margin="8,8,0,2"
                                          Content="阅读窗口保持置顶"
                                          IsChecked="{Binding SelectedBook.ReaderWindowTopmost, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="快捷操作" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="启用小悬浮窗后可以从桌面快速进入阅读。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="悬浮窗" />
                                <CheckBox Grid.Column="1" Margin="8,5" Content="显示“看书”悬浮窗"
                                          IsChecked="{Binding SelectedBook.FloatingWidgetEnabled, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="触发方式" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,9,0,5" Orientation="Horizontal">
                                    <RadioButton GroupName="ReaderFloatingTrigger" Content="点击"
                                                 IsChecked="{Binding SelectedBook.IsClickTrigger, Mode=TwoWay}" />
                                    <RadioButton GroupName="ReaderFloatingTrigger" Margin="18,0,0,0"
                                                 Content="停留 0.3 秒"
                                                 IsChecked="{Binding SelectedBook.IsPointerHoverTrigger, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Style="{DynamicResource FieldLabelStyle}" Text="自动隐藏" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,5" Orientation="Horizontal">
                                    <TextBox Width="82"
                                             Text="{Binding SelectedBook.ReaderAutoHideSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="秒后隐藏阅读窗口" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Margin="0,12,0,0"
                                      Content="拖到屏幕边缘或其他悬浮窗时自动吸附"
                                      IsChecked="{Binding SelectedBook.FloatingWidgetEdgeSnapEnabled, Mode=TwoWay}" />
                            <Button Margin="0,16,0,0" Style="{DynamicResource PrimaryActionButtonStyle}"
                                    Content="保存阅读设置" Command="{Binding SaveBookSettingsCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{DynamicResource StatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StatusText}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Margin="18,0,0,0" MaxWidth="360" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding LibraryPath}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
