<UserControl x:Class="TouchFish.Modules.Reader.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="940" MinHeight="640"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="看书" />
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="导入 TXT，选择章节并通过可缩放悬浮窗口阅读。" />
            </StackPanel>
            <Button MinWidth="120" Padding="12,8" HorizontalAlignment="Right"
                    Content="打开阅读窗口" Command="{Binding OpenReaderCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="书籍" />
                    <ListBox Grid.Row="1" Margin="0,10" ItemsSource="{Binding Books}"
                             SelectedItem="{Binding SelectedBook}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="3" Text="{Binding Title}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button Content="打开书库目录" Command="{Binding OpenLibraryFolderCommand}" />
                        <Button Margin="0,8,0,0" Content="导入 TXT" Command="{Binding ImportBookCommand}" />
                        <Button Margin="0,8,0,0" Content="删除所选书籍" Command="{Binding DeleteBookCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="12" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="章节" />
                    <ListBox x:Name="ChapterList" Grid.Row="1" Margin="0,10" ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding SelectedChapter}" HorizontalContentAlignment="Stretch"
                             SelectionChanged="ChapterList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="3" Text="{Binding Title}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <Border Padding="16" CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="阅读设置" />
                        <TextBlock Margin="0,12,0,2" Foreground="{DynamicResource TextSecondaryBrush}" Text="书名" />
                        <TextBox Text="{Binding SelectedBook.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,2" Foreground="{DynamicResource TextSecondaryBrush}" Text="阅读字体" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox IsReadOnly="True" Text="{Binding SelectedBook.ReaderFontFamily, Mode=OneWay}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5"
                                    Content="选择字体…" Command="{Binding ChooseFontCommand}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="字号" />
                            <Slider Grid.Column="1" Margin="12,0" Minimum="10" Maximum="48"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedBook.ReaderFontSize, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding SelectedBook.ReaderFontSize, StringFormat={}{0:0}}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="行间距" />
                            <Slider Grid.Column="1" Margin="12,0" Minimum="1" Maximum="3"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedBook.ReaderLineSpacing, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding SelectedBook.ReaderLineSpacing, StringFormat={}{0:0.00}}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="段落间距" />
                            <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="48"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedBook.ReaderParagraphSpacing, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding SelectedBook.ReaderParagraphSpacing, StringFormat={}{0:0}}" />
                        </Grid>

                        <CheckBox Margin="0,16,0,0" Content="阅读窗口始终置顶"
                                  IsChecked="{Binding SelectedBook.ReaderWindowTopmost, Mode=TwoWay}" />

                        <Separator Margin="0,16" />
                        <TextBlock FontWeight="SemiBold" Text="阅读小悬浮窗" />
                        <CheckBox Margin="0,12,0,0" Content="显示小悬浮窗"
                                  IsChecked="{Binding SelectedBook.FloatingWidgetEnabled, Mode=TwoWay}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <RadioButton GroupName="ReaderWidgetTrigger" Content="点击触发"
                                         IsChecked="{Binding SelectedBook.IsClickTrigger, Mode=TwoWay}" />
                            <RadioButton GroupName="ReaderWidgetTrigger" Margin="16,0,0,0" Content="停留 0.3 秒触发"
                                         IsChecked="{Binding SelectedBook.IsPointerHoverTrigger, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="离开后回收" />
                            <TextBox Grid.Column="1" Margin="10,0" HorizontalContentAlignment="Right"
                                     Text="{Binding SelectedBook.ReaderAutoHideSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="秒" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="从小悬浮窗进入阅读窗口时保留 1 秒过渡保护；光标进入后再离开按上述时间回收，0 秒表示立即隐藏。两种窗口各自保存位置。" />
                        <CheckBox Margin="0,12,0,0" Content="拖到屏幕边缘或其他悬浮窗时自动吸附并对齐"
                                  IsChecked="{Binding SelectedBook.FloatingWidgetEdgeSnapEnabled, Mode=TwoWay}" />

                        <Button Margin="0,18,0,0" Padding="12,8" Content="保存阅读设置"
                                Command="{Binding SaveBookSettingsCommand}" />
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="阅读进度、章节、窗口大小和位置会自动记忆。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LibraryPath}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,3,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
