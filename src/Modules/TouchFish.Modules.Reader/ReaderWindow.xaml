<Window x:Class="TouchFish.Modules.Reader.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="560" Height="420" MinWidth="320" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="Transparent">
    <Border x:Name="WindowSurface" Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <ScrollViewer x:Name="ReaderScroll" Padding="16,16,16,58"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ReaderText" TextWrapping="Wrap"
                           FontSize="16" LineHeight="26"
                           IsHitTestVisible="False" />
            </ScrollViewer>

            <Border VerticalAlignment="Bottom" Height="48" Margin="10"
                    Padding="10,6" CornerRadius="7"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="透明度" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Margin="10,0,0,0"
                            Minimum="0.25" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" Value="1"
                            ValueChanged="OpacitySlider_OnValueChanged" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button MinWidth="70" Padding="10,5" Content="上一章"
                                Click="PreviousChapter_OnClick" />
                        <Button MinWidth="70" Margin="8,0,0,0" Padding="10,5" Content="下一章"
                                Click="NextChapter_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
