<UserControl x:Class="TouchFish.Modules.Browser.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="820" MinHeight="580">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource PageTitleStyle}" Text="浏览器" />
                <TextBlock Style="{DynamicResource PageSubtitleStyle}"
                           Text="分别显示多个网页，并为每个网页保存独立的窗口和悬浮窗设置。" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource PrimaryActionButtonStyle}"
                    Content="显示所选网页" Command="{Binding OpenSelectedCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="网页列表" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                   Text="列表内开关控制每个网页窗口是否启用" />
                    </StackPanel>
                    <ListBox Grid.Row="1" Style="{DynamicResource ModernListBoxStyle}"
                             ItemContainerStyle="{DynamicResource ModernListItemStyle}"
                             ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,10,0" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                              Style="{DynamicResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="网页窗口独立开关" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource IconButtonStyle}" Content="&#xE710;" ToolTip="添加网页"
                                Command="{Binding AddSiteCommand}" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE74A;" ToolTip="上移" Command="{Binding MoveSiteUpCommand}" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE74B;" ToolTip="下移" Command="{Binding MoveSiteDownCommand}" />
                        <Button Grid.Column="4" Style="{DynamicResource DangerButtonStyle}"
                                Content="删除" Command="{Binding DeleteSiteCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="网页信息" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="网页名称修改后会自动保存；网址请直接在网页窗口中修改。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="名称" />
                                <TextBox Grid.Column="1" Margin="8,4"
                                         Text="{Binding SelectedSite.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="网页窗口" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="每个网页分别保存置顶状态、自动隐藏、大小和位置；透明度在网页窗口中选择。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="窗口" />
                                <CheckBox Grid.Column="1" Margin="8,8,0,5" Content="保持置顶"
                                          IsChecked="{Binding SelectedSite.WindowTopmost, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="自动隐藏" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,5" Orientation="Horizontal">
                                    <TextBox Width="82"
                                             Text="{Binding SelectedSite.AutoHideSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="秒后隐藏（0 为立即）" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="悬浮窗" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="为当前网页显示一个独立的快捷入口。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="显示悬浮窗" />
                                <CheckBox Grid.Column="1" Margin="8,6,0,6" Content="启用"
                                          IsChecked="{Binding SelectedSite.FloatingWidgetEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="触发方式" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,2" Orientation="Horizontal">
                                    <RadioButton GroupName="BrowserFloatingTrigger" Content="点击"
                                                 IsChecked="{Binding SelectedSite.IsClickTrigger, Mode=TwoWay}" />
                                    <RadioButton GroupName="BrowserFloatingTrigger" Margin="18,0,0,0"
                                                 Content="光标停留 0.3 秒"
                                                 IsChecked="{Binding SelectedSite.IsPointerHoverTrigger, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{DynamicResource StatusBarStyle}">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
