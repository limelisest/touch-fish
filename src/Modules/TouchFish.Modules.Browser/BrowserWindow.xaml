<Window x:Class="TouchFish.Modules.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="760" Height="560" MinWidth="360" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DragBar" Padding="12,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="DragBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SiteTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Width="30" Height="28" Padding="0" Margin="6,0,0,0"
                            ToolTip="刷新" Content="↻" Click="Reload_OnClick" />
                    <Button Grid.Column="2" Width="30" Height="28" Padding="0" Margin="6,0,0,0"
                            ToolTip="隐藏" Content="—" Click="Hide_OnClick" />
                </Grid>
            </Border>
            <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
