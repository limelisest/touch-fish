<Window x:Class="TouchFish.Modules.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="760" Height="560" MinWidth="420" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="Toolbar" Padding="8,4"
                    Background="{DynamicResource SurfaceAlternateBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" MinHeight="40" Padding="9,4"
                             IsReadOnly="True" VerticalContentAlignment="Center"
                             KeyDown="AddressBox_OnKeyDown"
                             LostKeyboardFocus="AddressBox_OnLostKeyboardFocus"
                             PreviewMouseLeftButtonDown="AddressBox_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="AddressBox_OnPreviewMouseMove"
                             PreviewMouseLeftButtonUp="AddressBox_OnPreviewMouseLeftButtonUp" />
                    <ComboBox x:Name="OpacitySelector" Grid.Column="1" Width="92" Height="40" Margin="8,0,0,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              SelectionChanged="OpacitySelector_OnSelectionChanged">
                        <ComboBoxItem HorizontalContentAlignment="Center" Content="100%" />
                        <ComboBoxItem HorizontalContentAlignment="Center" Content="75%" />
                        <ComboBoxItem HorizontalContentAlignment="Center" Content="50%" />
                        <ComboBoxItem HorizontalContentAlignment="Center" Content="25%" />
                    </ComboBox>
                    <Button Grid.Column="2" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                            ToolTip="刷新" Content="↻" Click="Reload_OnClick" />
                    <Button Grid.Column="3" Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                            ToolTip="隐藏" Content="—" Click="Hide_OnClick" />
                </Grid>
            </Border>
            <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
