<Window x:Class="TouchFish.Modules.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="760" Height="560" MinWidth="420" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DragBar" Padding="12,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="DragBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SiteTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Width="30" Height="28" Padding="0" Margin="6,0,0,0"
                            ToolTip="刷新" Content="↻" Click="Reload_OnClick" />
                    <Button Grid.Column="2" Width="30" Height="28" Padding="0" Margin="6,0,0,0"
                            ToolTip="隐藏" Content="—" Click="Hide_OnClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource SurfaceAlternateBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressBox" MinHeight="40" Padding="9,4"
                             VerticalContentAlignment="Center"
                             KeyDown="AddressBox_OnKeyDown" LostKeyboardFocus="AddressBox_OnLostKeyboardFocus" />
                    <Button Grid.Column="1" Width="42" Height="36" Margin="6,0,12,0" Padding="0"
                            Content="前往" Click="Navigate_OnClick" />
                    <TextBlock Grid.Column="2" Margin="0,0,7,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="透明度" />
                    <ComboBox x:Name="OpacitySelector" Grid.Column="3" Width="76" Height="36"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OpacitySelector_OnSelectionChanged">
                        <ComboBoxItem Content="100%" Tag="1" />
                        <ComboBoxItem Content="75%" Tag="0.75" />
                        <ComboBoxItem Content="50%" Tag="0.5" />
                        <ComboBoxItem Content="25%" Tag="0.25" />
                    </ComboBox>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="2" />
        </Grid>
    </Border>
</Window>
