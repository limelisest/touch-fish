<Window x:Class="TouchFish.Modules.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="网页" Width="760" Height="560"
        MinWidth="420" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Border x:Name="WindowSurface"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="6"
                    Background="{DynamicResource SurfaceAlternateBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AddressBox"
                             Grid.Column="0"
                             Height="32"
                             MinHeight="32"
                             Margin="0,0,6,0"
                             Padding="10,3"
                             Cursor="Arrow"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             ToolTip="按住拖动窗口；单击后编辑地址"
                             PreviewMouseLeftButtonDown="AddressBox_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="AddressBox_OnPreviewMouseMove"
                             PreviewMouseLeftButtonUp="AddressBox_OnPreviewMouseLeftButtonUp"
                             KeyDown="AddressBox_OnKeyDown"
                             LostKeyboardFocus="AddressBox_OnLostKeyboardFocus" />

                    <ComboBox x:Name="OpacitySelector"
                              Grid.Column="1"
                              Width="68"
                              Height="32"
                              MinHeight="32"
                              Margin="0,0,6,0"
                              ToolTip="窗口透明度"
                              SelectionChanged="OpacitySelector_OnSelectionChanged">
                        <ComboBoxItem Content="100%" Tag="1" />
                        <ComboBoxItem Content="75%" Tag="0.75" />
                        <ComboBoxItem Content="50%" Tag="0.5" />
                        <ComboBoxItem Content="25%" Tag="0.25" />
                    </ComboBox>

                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Margin="0,0,6,0"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip="刷新"
                            Click="Reload_OnClick">
                        <TextBlock FontFamily="Segoe UI Symbol"
                                   FontSize="17"
                                   Text="↻"
                                   TextAlignment="Center" />
                    </Button>

                    <Button Grid.Column="3"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip="隐藏"
                            Click="Hide_OnClick">
                        <Grid Width="14" Height="14">
                            <Border Height="1.5"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="1" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <wv2:WebView2CompositionControl x:Name="Browser"
                                            Grid.Row="1"
                                            DefaultBackgroundColor="White" />
        </Grid>
    </Border>
</Window>
