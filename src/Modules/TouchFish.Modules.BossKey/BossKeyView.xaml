<UserControl x:Class="TouchFish.Modules.BossKey.BossKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="500"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="老板键" />
            <TextBlock Margin="0,6,0,0" Foreground="#666" Text="按一次最小化已添加的窗口，再按一次恢复。" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="16" CornerRadius="8" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="全局快捷键" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#777" Text="点击右侧后按键" />
                </StackPanel>
                <Border x:Name="HotkeyCapture"
                        Grid.Column="1"
                        Padding="12,8"
                        BorderBrush="#AAB2BF"
                        BorderThickness="1"
                        CornerRadius="5"
                        Background="White"
                        Focusable="True"
                        MouseLeftButtonDown="HotkeyCapture_OnMouseLeftButtonDown"
                        PreviewKeyDown="HotkeyCapture_OnPreviewKeyDown">
                    <TextBlock x:Name="HotkeyCaptureText"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding HotkeyText}" />
                </Border>
                <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#777"
                           Text="至少包含 Ctrl、Alt 或 Shift；F12 不可用。" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="目标窗口" />
                <TextBlock Margin="0,4,0,0" Foreground="#777" Text="{Binding PickerHint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="PickerButton"
                    Grid.Column="1"
                    MinWidth="160"
                    Padding="14,8"
                    Content="⊕  点击选择窗口"
                    Click="PickerButton_OnClick" />
        </Grid>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Windows}"
                  SelectedItem="{Binding SelectedWindow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Width="1.4*" Header="名称（可修改）" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="1*" Header="进程" Binding="{Binding ProcessName}" IsReadOnly="True" />
                <DataGridTextColumn Width="2*" Header="标题包含（可修改）" Binding="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Width="100" Header="状态" Binding="{Binding CurrentState}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button MinWidth="90" Padding="12,7" Content="定位窗口" Command="{Binding LocateSelectedCommand}" />
                <Button MinWidth="90" Margin="8,0,0,0" Padding="12,7" Content="删除" Command="{Binding DeleteSelectedCommand}" />
                <Button MinWidth="90" Margin="8,0,0,0" Padding="12,7" Content="刷新状态" Command="{Binding RefreshWindowStatesCommand}" />
            </StackPanel>
            <Button Grid.Column="1" MinWidth="110" Padding="14,7" Content="保存修改" Command="{Binding SaveCommand}" />
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <Expander Header="所选窗口的识别信息">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="程序路径" Foreground="#666" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="8,2" IsReadOnly="True" Text="{Binding SelectedWindow.ProcessPath}" />
                    <TextBlock Grid.Row="1" Text="窗口类" Foreground="#666" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="8,2" IsReadOnly="True" Text="{Binding SelectedWindow.WindowClass}" />
                    <TextBlock Grid.Row="2" Text="AppUserModelID" Foreground="#666" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8,2" IsReadOnly="True" Text="{Binding SelectedWindow.AppUserModelId}" />
                    <TextBlock Grid.Row="3" Text="浏览器 App ID" Foreground="#666" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="8,2" IsReadOnly="True" Text="{Binding SelectedWindow.BrowserAppId}" />
                </Grid>
            </Expander>
            <TextBlock Margin="0,12,0,0" Foreground="#555" Text="{Binding StatusText}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
