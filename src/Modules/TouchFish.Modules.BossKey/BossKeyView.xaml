<UserControl x:Class="TouchFish.Modules.BossKey.BossKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="820" MinHeight="580">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{DynamicResource PageTitleStyle}" Text="老板键" />
            <TextBlock Style="{DynamicResource PageSubtitleStyle}"
                       Text="集中管理需要快速隐藏的窗口、快捷键和自动最小化规则。" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,16" Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="全局快捷键" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource FieldLabelStyle}"
                               Text="点击输入框后直接按下组合键" />
                </StackPanel>
                <Border x:Name="HotkeyCapture" Grid.Column="1" Height="36" Padding="10,0"
                        Focusable="True" CornerRadius="6"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        MouseLeftButtonDown="HotkeyCapture_OnMouseLeftButtonDown"
                        PreviewKeyDown="HotkeyCapture_OnPreviewKeyDown">
                    <TextBlock x:Name="HotkeyCaptureText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{Binding HotkeyText}" />
                </Border>
                <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="有窗口显示时统一最小化；全部最小化时统一恢复。" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="窗口列表" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                   Text="拖入或添加需要管理的应用窗口" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{DynamicResource ModernListBoxStyle}"
                             ItemContainerStyle="{DynamicResource ModernListItemStyle}"
                             ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PickerButton" Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE710;" ToolTip="添加窗口" Click="PickerButton_OnClick" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE74A;" ToolTip="上移" Command="{Binding MoveSelectedUpCommand}" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}"
                                Content="&#xE74B;" ToolTip="下移" Command="{Binding MoveSelectedDownCommand}" />
                        <Button Grid.Column="4" Style="{DynamicResource DangerButtonStyle}"
                                Content="删除" Command="{Binding DeleteSelectedCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="窗口详情" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="名称和匹配条件修改后会自动保存。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="名称" />
                                <TextBox Grid.Column="1" Margin="8,4,16,4"
                                         Text="{Binding SelectedWindow.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Style="{DynamicResource FieldLabelStyle}" Text="标题包含" />
                                <TextBox Grid.Column="3" Margin="8,4"
                                         Text="{Binding SelectedWindow.TitleContains, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="进程" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="8,4,16,4" IsReadOnly="True"
                                         Text="{Binding SelectedWindow.ProcessName}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{DynamicResource FieldLabelStyle}" Text="进程路径" />
                                <TextBox Grid.Row="1" Grid.Column="3" Margin="8,4" IsReadOnly="True"
                                         Text="{Binding SelectedWindow.ProcessPath}" />

                                <TextBlock Grid.Row="2" Style="{DynamicResource FieldLabelStyle}" Text="窗口类名" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,4" IsReadOnly="True"
                                         Text="{Binding SelectedWindow.WindowClass}" />

                                <TextBlock Grid.Row="3" Style="{DynamicResource FieldLabelStyle}" Text="自动最小化" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,8,0,0" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center" Content="启用"
                                              IsChecked="{Binding SelectedWindow.AutoMinimizeEnabled, Mode=TwoWay}" />
                                    <TextBox Width="70" Margin="16,0,8,0"
                                             Text="{Binding SelectedWindow.AutoMinimizeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="秒后" />
                                    <Button Margin="18,0,0,0" Content="应用到全部窗口"
                                            Command="{Binding SyncAutoMinimizeToAllCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="悬浮窗" />
                            <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                                       Text="通过一个紧凑入口快速显示或隐藏当前窗口。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="显示悬浮窗" />
                                <CheckBox Grid.Column="1" Margin="8,6,0,6" VerticalAlignment="Center" Content="启用"
                                          IsChecked="{Binding SelectedWindow.FloatingWidgetEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelStyle}" Text="触发方式" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,10,0,2" Orientation="Horizontal">
                                    <RadioButton GroupName="FloatingWidgetTrigger" Content="点击"
                                                 IsChecked="{Binding SelectedWindow.IsClickTrigger, Mode=TwoWay}" />
                                    <RadioButton GroupName="FloatingWidgetTrigger" Margin="20,0,0,0"
                                                 Content="光标停留 0.3 秒"
                                                 IsChecked="{Binding SelectedWindow.IsPointerHoverTrigger, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Style="{DynamicResource StatusBarStyle}">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

    </Grid>
</UserControl>
