<UserControl x:Class="TouchFish.Modules.BossKey.BossKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="800" MinHeight="620"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="老板键" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="统一隐藏、显示和快速打开指定窗口。" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="窗口列表" />
                    <ListBox Grid.Row="1" Margin="0,12,0,12"
                             ItemsSource="{Binding Windows}"
                             SelectedItem="{Binding SelectedWindow}"
                             DisplayMemberPath="Name"
                             HorizontalContentAlignment="Stretch" />

                    <Button x:Name="PickerButton" Grid.Row="2" Padding="12,8"
                            Content="＋ 添加窗口" Click="PickerButton_OnClick" />

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,4,0" Content="上移" Command="{Binding MoveSelectedUpCommand}" />
                        <Button Grid.Column="1" Margin="4,0" Content="下移" Command="{Binding MoveSelectedDownCommand}" />
                        <Button Grid.Column="2" Margin="4,0,0,0" Content="删除" Command="{Binding DeleteSelectedCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="16" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="全局快捷键" />
                            <Border x:Name="HotkeyCapture" Grid.Column="1" Padding="12,8" CornerRadius="5"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource ControlBackgroundBrush}" Focusable="True"
                                    MouseLeftButtonDown="HotkeyCapture_OnMouseLeftButtonDown"
                                    PreviewKeyDown="HotkeyCapture_OnPreviewKeyDown">
                                <TextBlock x:Name="HotkeyCaptureText" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Text="{Binding HotkeyText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="16" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="窗口详情" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="名称"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,3"
                                         Text="{Binding SelectedWindow.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="标题包含"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,3"
                                         Text="{Binding SelectedWindow.TitleContains, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="程序路径"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,3"
                                         IsReadOnly="True" Text="{Binding SelectedWindow.ProcessPath}" />

                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="窗口类"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,3"
                                         IsReadOnly="True" Text="{Binding SelectedWindow.WindowClass}" />

                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="浏览器 App ID"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="8,3"
                                         IsReadOnly="True" Text="{Binding SelectedWindow.BrowserAppId}" />
                            </Grid>

                            <Separator Margin="0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="自动最小化"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,3" Orientation="Horizontal">
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="启用"
                                              IsChecked="{Binding SelectedWindow.AutoMinimizeEnabled, Mode=TwoWay}" />
                                    <TextBox Width="72" Padding="7,4"
                                             IsEnabled="{Binding SelectedWindow.AutoMinimizeEnabled}"
                                             Text="{Binding SelectedWindow.AutoMinimizeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" Text="秒" />
                                    <Button Padding="12,5" Content="同步到所有窗口"
                                            Command="{Binding SyncAutoMinimizeToAllCommand}" />
                                </StackPanel>

                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="16" CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="悬浮窗设置" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="悬浮窗"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <CheckBox Grid.Column="1" Margin="8,5" VerticalAlignment="Center"
                                          Content="为此窗口显示悬浮窗"
                                          IsChecked="{Binding SelectedWindow.FloatingWidgetEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="触发方式"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,5" Orientation="Horizontal">
                                    <RadioButton GroupName="FloatingWidgetTrigger" VerticalAlignment="Center"
                                                 Content="点击触发"
                                                 IsChecked="{Binding SelectedWindow.IsClickTrigger, Mode=TwoWay}" />
                                    <RadioButton GroupName="FloatingWidgetTrigger" Margin="14,0,0,0" VerticalAlignment="Center"
                                                 Content="光标停留 0.3 秒触发"
                                                 IsChecked="{Binding SelectedWindow.IsPointerHoverTrigger, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
