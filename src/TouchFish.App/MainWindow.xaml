<Window x:Class="TouchFish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchFish"
        Icon="/Assets/app-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1360" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FeatureToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Content" Value="关" />
            <Setter Property="ToolTip" Value="点击启用功能" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="开" />
                    <Setter Property="ToolTip" Value="点击关闭功能" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="PrimaryNavigation" BorderThickness="0"
                         Background="Transparent" SelectedIndex="0"
                         SelectionChanged="Navigation_OnSelectionChanged">
                    <ListBoxItem Margin="0,0,0,5" Padding="12,7" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="老板键" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource FeatureToggleStyle}"
                                          IsChecked="{Binding BossKeyFeatureEnabled, Mode=TwoWay}" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Margin="0,0,0,5" Padding="12,7" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="看书" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource FeatureToggleStyle}"
                                          IsChecked="{Binding ReaderFeatureEnabled, Mode=TwoWay}" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
                <ListBox x:Name="SettingsNavigation" Grid.Row="1" BorderThickness="0"
                         Background="Transparent" SelectionChanged="SettingsNavigation_OnSelectionChanged">
                    <ListBoxItem Padding="12,10" Content="设置" />
                </ListBox>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
