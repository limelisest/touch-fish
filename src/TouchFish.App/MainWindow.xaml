<Window x:Class="TouchFish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchFish"
        Icon="/Assets/app-icon.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1180" Height="800" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="158" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="PrimaryNavigation" BorderThickness="0"
                         Background="Transparent" SelectedIndex="0"
                         SelectionChanged="Navigation_OnSelectionChanged">
                    <ListBoxItem Margin="0,0,0,5" Padding="12,10" Content="老板键" />
                    <ListBoxItem Margin="0,0,0,5" Padding="12,10" Content="看书" />
                </ListBox>
                <ListBox x:Name="SettingsNavigation" Grid.Row="1" BorderThickness="0"
                         Background="Transparent" SelectionChanged="SettingsNavigation_OnSelectionChanged">
                    <ListBoxItem Padding="12,10" Content="设置" />
                </ListBox>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
