<UserControl x:Class="TouchFish.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="设置" />
            <TextBlock Margin="0,5,0,18" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="管理启动行为和查看应用信息。" />

            <Border Padding="18" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="启动" />
                    <CheckBox Margin="0,16,0,0" Content="开机自启动"
                              IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="26,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="保存此选项时会请求一次管理员权限；登录后 TouchFish 仍以普通权限运行。" />
                    <CheckBox Margin="0,14,0,0" Content="静默启动"
                              IsEnabled="{Binding AutoStartEnabled}"
                              IsChecked="{Binding SilentStartup, Mode=TwoWay}" />
                    <TextBlock Margin="26,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="仅开机自启动时隐藏主窗口；托盘、老板键和悬浮窗仍会运行。" />
                    <Button Margin="0,18,0,0" Width="110" HorizontalAlignment="Left"
                            Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="18" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="关于" />
                    <TextBlock Grid.Row="1" Text="应用" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="TouchFish" />
                    <TextBlock Grid.Row="2" Text="版本" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}" />
                    <TextBlock Grid.Row="3" Text="编译时间" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Grid.Row="3" Grid.Column="1">
                        <TextBlock Text="{Binding BuildTime}" />
                        <TextBlock Margin="0,8,0,0" Text="作者：LimeLisest" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
