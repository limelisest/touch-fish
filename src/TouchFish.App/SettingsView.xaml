<UserControl x:Class="TouchFish.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700" MinHeight="500">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Style="{DynamicResource PageTitleStyle}" Text="设置" />
                <TextBlock Style="{DynamicResource PageSubtitleStyle}"
                           Text="管理 TouchFish 的启动方式、界面外观和应用信息。" />
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="启动" />
                    <TextBlock Margin="0,4,0,14" Style="{DynamicResource PageSubtitleStyle}"
                               Text="开机启动通过 Windows 计划任务实现，修改时可能请求管理员权限。" />

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="开机自动启动" />
                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                       Text="登录 Windows 后自动运行 TouchFish" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="0,14" />

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="静默启动" />
                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource FieldLabelStyle}"
                                       Text="启动后留在后台，不主动显示主窗口" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsEnabled="{Binding AutoStartEnabled}"
                                  IsChecked="{Binding SilentStartup, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="外观" />
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource PageSubtitleStyle}"
                                   Text="界面会自动跟随 Windows 的浅色或深色应用设置。" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,5" VerticalAlignment="Center" CornerRadius="12"
                            Background="{DynamicResource SuccessSurfaceBrush}">
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" Text="跟随系统" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource SectionTitleStyle}" Text="关于 TouchFish" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Version, StringFormat=版本 {0}}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding BuildTime, StringFormat=编译于 {0}}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" CornerRadius="14"
                            Background="{DynamicResource SelectionBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="23" Foreground="{DynamicResource AccentBrush}"
                                   Text="&#xE946;" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,14,0" Style="{DynamicResource StatusBarStyle}">
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Border>
                <Button Grid.Column="1" MinWidth="116" Style="{DynamicResource PrimaryActionButtonStyle}"
                        Content="保存设置" Command="{Binding SaveSettingsCommand}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
