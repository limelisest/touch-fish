<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TouchFish.App</RootNamespace>
    <AssemblyName>TouchFish</AssemblyName>
    <Version>0.13.10</Version>
    <Product>TouchFish</Product>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$([System.DateTime]::UtcNow.ToString('O'))" />
    <None Remove="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="WPF-UI" />
    <PackageDownload Include="Microsoft.Windows.CsWinRT" Version="[1.6.5]" />
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.17763.17]" />
    <ProjectReference Include="..\TouchFish.Contracts\TouchFish.Contracts.csproj" />
    <ProjectReference Include="..\TouchFish.Platform.Windows\TouchFish.Platform.Windows.csproj" />
    <ProjectReference Include="..\Modules\TouchFish.Modules.BossKey\TouchFish.Modules.BossKey.csproj" />
    <ProjectReference Include="..\Modules\TouchFish.Modules.Browser\TouchFish.Modules.Browser.csproj" />
    <ProjectReference Include="..\Modules\TouchFish.Modules.Reader\TouchFish.Modules.Reader.csproj" />
    <Reference Include="Microsoft.Windows.SDK.NET"
               HintPath="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/10.0.17763.17/lib/Microsoft.Windows.SDK.NET.dll"
               Private="true" />
    <Reference Include="WinRT.Runtime"
               HintPath="$(NuGetPackageRoot)microsoft.windows.cswinrt/1.6.5/lib/net5.0/WinRT.Runtime.dll"
               Private="true" />
  </ItemGroup>
</Project>
